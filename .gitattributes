# Normalise text to LF in the repository; check out native on Windows.
* text=auto

# Must stay LF regardless of platform — a CRLF gradlew is not executable by
# /bin/sh, so a Windows-checked-out copy would fail on Linux and macOS.
gradlew text eol=lf
*.sh text eol=lf

# Windows-only, must stay CRLF.
gradlew.bat text eol=crlf

# Binary — never touch.
*.jar binary
*.keystore binary
*.jks binary
*.png binary
*.webp binary
*.avault binary
*.db binary
